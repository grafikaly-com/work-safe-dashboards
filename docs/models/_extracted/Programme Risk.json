    {
      "table": "RiskRegister",
      "name": "IsTreated",
      "expression": "\nVAR Response = SELECTEDVALUE('RiskRegister'[Response])\nVAR JunctionCount = COUNTROWS(Junctions)\nRETURN\nIF ( Response = \"Treat\", IF ( JunctionCount > 0, \"Yes\", \"No\" ), \"N/A\" )\n",
      "display_folder": null,
      "description": null,
      "used_in_report": true
    },
    {
      "table": "RiskRegister",
      "name": "OverdueTreatmentCount",
      "expression": "\nIf(CALCULATE(\n    COUNTROWS( TreatmentRegister ),\n    KEEPFILTERS( TREATAS( VALUES( Junctions[TreatID] ), TreatmentRegister[ID] ) ),\n    NOT ISBLANK( TreatmentRegister[DueDate] ),\n    TreatmentRegister[DueDate] < TODAY()\n)>0,CALCULATE(\n    COUNTROWS( TreatmentRegister ),\n    KEEPFILTERS( TREATAS( VALUES( Junctions[TreatID] ), TreatmentRegister[ID] ) ),\n    NOT ISBLANK( TreatmentRegister[DueDate] ),\n    TreatmentRegister[DueDate] < TODAY()),0)",
      "display_folder": null,
      "description": null,
      "used_in_report": true
    },
    {
      "table": "RiskRegister",
      "name": "HasOverdueTreatments",
      "expression": "IF(\n[OverdueTreatmentCount] > 0,\"Yes\",\"No\")",
      "display_folder": null,
      "description": null,
      "used_in_report": true
    },
    {
